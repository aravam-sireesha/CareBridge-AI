# Normally NOT needed: the Vite dev server proxies /api to the backend.
# VITE_BACKEND_URL=http://127.0.0.1:8000      # where the Vite proxy should send /api (dev + preview)
# VITE_API_URL=https://api.example.com        # only if the browser must call a different API origin

# Optional: a tile server for the 2D fallback map. Must contain {z}, {x} and {y}. Default is OpenStreetMap's public
# server, fine for light use; use your own provider account for a busy site.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- Everything below is PUBLIC: it is compiled into the browser bundle. Never put a server secret here. ----
# Google Maps Platform BROWSER key (Photorealistic 3D Tiles). In Google Cloud Console restrict it by HTTP referrer
# (your site only) and to the Map Tiles API. Leave empty to use the 2D map only.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Cloud-based map style id
VITE_GOOGLE_MAP_ID=
# CesiumJS release loaded on demand from Cesium's CDN. Verify it exists at https://cesium.com/downloads/
VITE_CESIUM_VERSION=1.121
# Browser error monitoring (a DSN is public by design). Leave empty to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
