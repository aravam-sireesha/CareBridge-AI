{
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\""
  }
}
