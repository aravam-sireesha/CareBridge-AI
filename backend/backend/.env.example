# Use a persistent database for local development or PostgreSQL in production.
DATABASE_URL=postgresql+psycopg2://carebridge:change-me@localhost:5432/carebridge
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Optional password-reset mail transport. Reset requests stay generic if SMTP is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Optional OpenAI-compatible grounded answer generation.
# Without this, the assistant returns retrieved source excerpts (no invented answer).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# First administrator (one time). Put a random token of 24+ characters here, open http://localhost:5173/admin/setup,
# create the account, then DELETE this line. Setup closes by itself once any administrator exists.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Alternative without a token:  python scripts/create_admin.py
ADMIN_SETUP_TOKEN=
# Administrator session length in minutes (default 480 = 8 hours).
ADMIN_TOKEN_MINUTES=480

# Sign-in protection (defaults shown). 5 wrong passwords lock an account for 15 minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Per-address limit on sign-in / sign-up / password-reset requests (in-memory, per server process).
AUTH_RATE_LIMIT=40
AUTH_RATE_WINDOW=300
# Per-address limit (per minute) for the public landing-page data endpoints (/public/*).
PUBLIC_RATE_LIMIT=120
# Set to true only behind a reverse proxy you control (reads X-Forwarded-For for the audit trail and rate limit).
TRUST_PROXY=false
# Set to true when the site is served over HTTPS (adds the Strict-Transport-Security header).
FORCE_HTTPS=false

# Assistant: answers below this confidence are refused instead of guessed. Re-tune after
# `python scripts/eval_rag.py --dense --fresh`. Leave empty for the default (0.33).
RAG_CONFIDENCE_THRESHOLD=
