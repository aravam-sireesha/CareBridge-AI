# Use a persistent database for local development or PostgreSQL in production.
DATABASE_URL=postgresql+psycopg2://carebridge:change-me@localhost:5432/carebridge
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Optional password-reset mail transport. Reset requests stay generic if SMTP is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Chat assistant language model (optional). Any OpenAI-compatible API works: OpenAI, Groq, Together, or a local server such as Ollama.
# With NO model configured the assistant still works: it answers from retrieval and live database analysis and labels the reply as such.
#   OpenAI:  LLM_API_KEY=sk-...   (base URL and models below keep their defaults)
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   (no key needed)
# The old OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL names are still read if the LLM_* ones are empty.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Optional cheaper/faster model used for short questions that need no live analysis. Defaults to LLM_MODEL.
LLM_FAST_MODEL=
# Seconds to wait for the next streamed chunk before giving up and falling back (5-120).
LLM_TIMEOUT_SECONDS=30

# First administrator (one time). Put a random token of 24+ characters here, open http://localhost:5173/admin/setup,
# create the account, then DELETE this line. Setup closes by itself once any administrator exists.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Alternative without a token:  python scripts/create_admin.py
ADMIN_SETUP_TOKEN=
# Administrator session length in minutes (default 480 = 8 hours).
ADMIN_TOKEN_MINUTES=480

# Sign-in protection (defaults shown). 5 wrong passwords lock an account for 15 minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Per-address limit on sign-in / sign-up / password-reset requests (in-memory, per server process).
AUTH_RATE_LIMIT=40
AUTH_RATE_WINDOW=300
# Per-address limit (per minute) for the public landing-page data endpoints (/public/*).
PUBLIC_RATE_LIMIT=120
# Set to true only behind a reverse proxy you control (reads X-Forwarded-For for the audit trail and rate limit).
TRUST_PROXY=false
# Set to true when the site is served over HTTPS (adds the Strict-Transport-Security header).
FORCE_HTTPS=false

# Assistant: answers below this confidence are refused instead of guessed. Re-tune after
# `python scripts/eval_rag.py --dense --fresh`. Leave empty for the default (0.33).
RAG_CONFIDENCE_THRESHOLD=

# Load the embedding model in the background at startup so the first question is not slow. Set to off to disable.
EMBEDDING_WARMUP=on

# ---- Added in this round ----
# Where the server runs. Anything other than development/dev/local/test is treated as production, so the dev-only OTP
# delivery modes below are refused. Leave unset (= production) on a real server.
APP_ENV=production

# Account-recovery codes. Real delivery uses the SMTP_* settings above. For LOCAL TESTING ONLY set APP_ENV=development
# and OTP_DELIVERY=console (prints the code in the server window) or outbox (in memory, used by the tests).
OTP_DELIVERY=
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Distances: default search radius in km when nobody chose one (1 to 500).
GEO_DEFAULT_RADIUS_KM=25

# Deliveries: set to false to let organizations skip administrator approval (donor commitment and volunteer acceptance
# are always required).
DELIVERY_APPROVAL_REQUIRED=true

# ---- Added with registration verification, availability and SMS ----
# Require NEW self-registered accounts to verify their e-mail address before signing in. Off by default. It only takes effect when the
# server can actually send codes (SMTP_HOST and SMTP_FROM set); otherwise it is ignored so nobody is locked out. Existing accounts are never affected.
REQUIRE_EMAIL_VERIFICATION=false

# Timezone assumed for a volunteer who has not chosen one (any IANA name, e.g. Asia/Kolkata). On Windows the `tzdata` package is required (in requirements.txt).
APP_TIMEZONE=Asia/Kolkata

# SMS provider: twilio (worldwide) or msg91 (India, DLT-compliant). Leave empty to disable SMS.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91 (India): the template/flow id comes from the MSG91 dashboard. Its text must be your DLT-registered template with two
# variables, e.g. "Your CareBridge code is ##VAR1##. It expires in ##VAR2## minutes. Do not share it."
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Registered on a DLT portal through your telecom operator. Nothing is sent to +91 numbers until all three are set.
SMS_SENDER_ID=
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=
# Require NEW self-registered accounts to verify their mobile number by SMS before signing in (needs a working SMS provider,
# otherwise ignored so nobody is locked out). When on, a mobile number is mandatory at sign-up.
REQUIRE_PHONE_VERIFICATION=false
# Local testing only (needs APP_ENV=development): console prints the SMS code in the server window, outbox keeps it in memory.
SMS_DELIVERY=

# =====================================================================================================================
# Production-readiness round. Every value below is a PLACEHOLDER. Real values go in a private .env (never committed) or in
# your host's secret store. Use separate credentials for development and production.
# =====================================================================================================================

# ---- Redis (shared rate limits, live-event fan-out and replay, job queue). Unset = single-process fallbacks. ----
#   docker compose provides it:  REDIS_URL=redis://redis:6379/0      With a password: redis://:PASSWORD@host:6379/0
REDIS_URL=

# ---- Public site address, used in e-mail links ----
APP_BASE_URL=http://localhost:5173

# ---- E-mail (any SMTP provider: Brevo, Amazon SES, SendGrid, ...). SMTP_HOST/SMTP_PORT/SMTP_FROM/SMTP_USERNAME/SMTP_PASSWORD
#      are documented at the top of this file. Extra switches: ----
# true = implicit TLS (usually port 465). Leave false for STARTTLS on 587.
SMTP_SSL=false
# Send notification e-mails (need decisions, donation confirmations, delivery alerts) from the background worker.
EMAIL_NOTIFICATIONS_ENABLED=false

# ---- SMS: SMS_PROVIDER, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, MSG91_AUTH_KEY are documented above. ----
# Twilio's own name for the sender number (TWILIO_FROM above is also read, and wins if both are set).
TWILIO_PHONE_NUMBER=
# India: TRAI DLT sender, entity and template registration is REQUIRED (SMS_SENDER_ID, DLT_ENTITY_ID, DLT_TEMPLATE_ID above).

# ---- WhatsApp Business Cloud API (Meta). Stays OFF until the business is verified and templates are approved. ----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved template names (template-only: free text is never sent)
WHATSAPP_TEMPLATE_DELIVERY_UPDATE=
WHATSAPP_TEMPLATE_DONATION_CONFIRMATION=
WHATSAPP_TEMPLATE_NEED_NOTICE=

# ---- Google Maps Platform (SERVER key: Places, Geocoding, Routes). Restrict by server IP and by these APIs only.
#      The browser key lives in frontend/.env (VITE_GOOGLE_MAPS_API_KEY) and is restricted by HTTP referrer. ----
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_GEOCODING_ENABLED=false
GOOGLE_ROUTES_ENABLED=false

# ---- Private file storage (S3-compatible: Amazon S3, Cloudflare R2, MinIO). Buckets must be PRIVATE. ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Signed download links live this many seconds (max 900)
S3_SIGNED_URL_SECONDS=300
# Largest accepted upload in megabytes
UPLOAD_MAX_MB=5

# ---- Error monitoring ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# ---- Web Push (VAPID). Generate once:  python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); v.save_key('private.pem'); v.save_public_key('public.pem')"
#      then put the base64url public key in VAPID_PUBLIC_KEY and the private key (PEM text or file path) in VAPID_PRIVATE_KEY. ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# ---- Live GPS tracking ----
# A volunteer may choose to let admins keep a movement trail. Off here = nobody can even be asked.
TRACKING_HISTORY_ENABLED=true
# Days a recorded trail is kept before the worker deletes it (1-365)
LOCATION_RETENTION_DAYS=30
# A shared position older than this many seconds is shown as "last known", not live
TRACKING_STALE_SECONDS=120

# ---- Background worker ----
# Used ONLY when Redis is not available: true (default) = run queued jobs on a background thread inside the web process, so development works
# without a worker and a Redis outage degrades instead of dropping notifications. With Redis healthy, jobs always go to `python -m app.worker`.
# Set false only in automated tests.
JOBS_INLINE=true
JOB_MAX_ATTEMPTS=5

# ---- Razorpay (payments). OFF until legal, tax, organisational and FCRA reviews are complete. ----
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Hosting ----
# Comma-separated browser origins allowed to call the API directly (default: local dev servers)
CORS_ORIGINS=http://localhost:5173

# ---- Worker, jobs and observability (added in the background-services phase) ----
# Threads per `python -m app.worker` process (1-8)
WORKER_CONCURRENCY=2
# Threads that send Web Push when there is no Redis worker (development only)
PUSH_WORKERS=2
# Extra push-service host suffixes beyond Google FCM, Mozilla, Apple and Microsoft (comma-separated). Leave empty unless a provider needs it.
PUSH_ALLOWED_HOSTS=
# A single payment may not exceed this many rupees (1-1000000). Payments stay OFF until PAYMENTS_ENABLED=true; see DEPLOYMENT_GUIDE.md.
PAYMENT_MAX_RUPEES=50000
# Hours a live-location sharing session may last before it is stopped automatically (1-48)
TRACKING_SESSION_MAX_HOURS=12
# Shown in error reports so a bug can be tied to a release
APP_RELEASE=
LOG_LEVEL=INFO
